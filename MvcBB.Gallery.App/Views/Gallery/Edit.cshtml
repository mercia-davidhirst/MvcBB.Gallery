@using MvcBB.Gallery.App
@model GalleryImageDto
@{
    ViewData["Title"] = "Edit Image";
    var categories = (IEnumerable<GalleryCategoryDto>)ViewBag.Categories;
}

<h1>Edit Image</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <div class="mb-3">
        <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="max-height: 200px;" />
    </div>
    <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select" required>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" maxlength="200" value="@Model.Name" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="4" maxlength="2000">@Model.Description</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Image" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>
