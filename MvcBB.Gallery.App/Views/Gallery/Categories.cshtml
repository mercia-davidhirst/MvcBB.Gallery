@using MvcBB.Gallery.App
@model IEnumerable<GalleryCategoryDto>
@{
    ViewData["Title"] = "Gallery Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gallery Categories</h1>
    <a asp-action="CreateCategory" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Category</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.OrderBy(c => c.SortOrder))
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>@category.SortOrder</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category and every image in it?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
