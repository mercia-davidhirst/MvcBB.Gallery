@using MvcBB.Gallery.App
@using MvcBB.Shared.Interfaces
@inject IBBCodeService BBCodeService
@model GalleryImageDto
@{
    ViewData["Title"] = Model.Name;
    bool canManage = ViewBag.CanManage;
}

<div class="row">
    <div class="col-lg-8">
        <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" alt="@Model.Name" />
    </div>
    <div class="col-lg-4">
        <h1 class="h3">@Model.Name</h1>
        <p class="text-muted">
            By @Model.UploadedByUsername on @Model.UploadedAt.ToString("d MMM yyyy")<br />
            <i class="bi bi-eye"></i> @Model.ViewCount views
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="mb-3">@Html.Raw(BBCodeService.ParseBBCode(Model.Description))</div>
        }

        <form asp-action="LikeImage" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-hand-thumbs-up@(Model.LikedByCurrentUser ? "-fill" : "")"></i>
                @(Model.LikeCount > 0 ? Model.LikeCount.ToString() : "Like")
            </button>
        </form>

        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary ms-1">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete this image?');">
                <button type="submit" class="btn btn-sm btn-outline-danger ms-1"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
    </div>
</div>

<hr />

<h2 class="h5">Comments (@(Model.Comments?.Count ?? 0))</h2>

<form asp-action="AddComment" method="post" class="mb-3">
    <input type="hidden" name="imageId" value="@Model.Id" />
    <div class="mb-2">
        <textarea name="content" class="form-control" rows="2" placeholder="Add a comment..." required></textarea>
    </div>
    <button type="submit" class="btn btn-sm btn-primary">Post Comment</button>
</form>

@if (Model.Comments == null || !Model.Comments.Any())
{
    <p class="text-muted">No comments yet.</p>
}
else
{
    foreach (var comment in Model.Comments)
    {
        <div class="border-top pt-2 mb-2">
            <div class="d-flex justify-content-between">
                <strong>@comment.CreatedByUsername</strong>
                <small class="text-muted">@comment.CreatedAt.ToString("d MMM yyyy - HH:mm")</small>
            </div>
            <div>@Html.Raw(BBCodeService.ParseBBCode(comment.Content))</div>
            @{
                var isOwnComment = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.CreatedByUserId.ToString();
            }
            @if (User.IsInRole("Administrator") || User.IsInRole("Moderator") || isOwnComment)
            {
                <form asp-action="DeleteComment" asp-route-id="@comment.Id" asp-route-imageId="@Model.Id" method="post"
                      onsubmit="return confirm('Delete this comment?');">
                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                </form>
            }
        </div>
    }
}
